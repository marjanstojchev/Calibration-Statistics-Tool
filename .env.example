# Environment Variables Configuration

# Python
PYTHONUNBUFFERED=1

# Qt (for headless mode in containers)
QT_QPA_PLATFORM=offscreen

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Azure Configuration (for GitLab CI/CD deployment)
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id
# AZURE_RESOURCE_GROUP=cst-rg

# GitLab Container Registry (automatically set in CI/CD)
# CI_REGISTRY=registry.gitlab.com
# CI_REGISTRY_USER=gitlab-ci-token
# CI_REGISTRY_PASSWORD=$CI_JOB_TOKEN
# CI_REGISTRY_IMAGE=registry.gitlab.com/yourproject/calibration-statistics-tool

# Optional: Application Insights (Azure monitoring)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string

# Optional: Storage configuration
# AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
# AZURE_STORAGE_SHARE_NAME=cst-data
