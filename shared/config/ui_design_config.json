{
  "_comment": "Calibration Statistics Tool — UI Design Configuration",
  "_version": "1.0.0",
  "_design": "Professional dark-navy engineering tool theme (JetBrains Darcula-inspired)",

  "palette": {
    "background": {
      "primary":    "#1a1f2e",
      "secondary":  "#232b3e",
      "tertiary":   "#2b3450",
      "alt_row":    "#1e2840",
      "hover":      "#2e3d58",
      "selection":  "#1a4680"
    },
    "accent": {
      "default":    "#3d8ef0",
      "hover":      "#5da5ff",
      "pressed":    "#2d6fcc",
      "disabled":   "#1e3a60"
    },
    "text": {
      "primary":    "#d6e4f7",
      "secondary":  "#7a98be",
      "disabled":   "#3d526e",
      "on_accent":  "#ffffff",
      "header":     "#9bbbd8"
    },
    "border": {
      "default":    "#374a6a",
      "focus":      "#3d8ef0",
      "hover":      "#4d6488"
    },
    "semantic": {
      "info":       "#b8d4f5",
      "info_bg":    "#1a2a42",
      "debug":      "#7ab2f0",
      "debug_bg":   "#1a2a42",
      "warning":    "#f5a623",
      "warning_bg": "#3a2806",
      "error":      "#ff6b6b",
      "error_bg":   "#3a0c0c",
      "critical":   "#ff2d2d",
      "critical_bg":"#560808"
    },
    "tab": {
      "active_bg":      "#2b3a58",
      "inactive_bg":    "#1a1f2e",
      "hover_bg":       "#232e48",
      "active_text":    "#d6e4f7",
      "inactive_text":  "#6a8ab0"
    },
    "scrollbar": {
      "track":          "#1a1f2e",
      "handle":         "#374a6a",
      "handle_hover":   "#4d6890"
    }
  },

  "typography": {
    "font_family": ["Segoe UI", "Inter", "Helvetica Neue", "Arial", "sans-serif"],
    "font_size_base_pt": 9,
    "font_size_small_pt": 8,
    "font_size_large_pt": 11,
    "font_weight_normal": 400,
    "font_weight_bold": 700
  },

  "spacing": {
    "h_layout":     10,
    "v_layout":     10,
    "grid":         10,
    "margins_main": [10, 10, 10, 10],
    "margins_tab":  [8, 8, 8, 8],
    "margins_group":[8, 18, 8, 8]
  },

  "sizing": {
    "progress_bar_w":    260,
    "push_btn_w":        128,
    "push_btn_h":        28,
    "line_edit_sm_w":    112,
    "line_edit_path_w":  300,
    "label_path_w":      340,
    "line_edit_h":       24,
    "v_line_width":      1,
    "h_line_height":     1
  },

  "window": {
    "title":       "Calibration Statistics Tool",
    "min_width":   1280,
    "min_height":  800,
    "default_width":  1440,
    "default_height": 900
  },

  "border_radius": {
    "small":  3,
    "medium": 4,
    "large":  6,
    "round":  50
  },

  "elevation": {
    "shadow_blur":   8,
    "shadow_x":      4,
    "shadow_y":      4,
    "shadow_color":  "rgba(0, 0, 0, 0.45)"
  },

  "icons": {
    "_note": "Place a 32x32 ICO file at assets/app_icon.ico to enable taskbar icon",
    "app_icon_path": "assets/app_icon.ico",
    "app_icon_path_png": "assets/app_icon.png"
  },

  "log_table": {
    "row_height": 22,
    "max_rows_before_autoscroll": 500,
    "timestamp_col_width": 160,
    "level_col_width": 80
  }
}
